# Copy to .env in this folder, or put .env one folder above this project. Never commit the real file.
# The app reads this folder's .env first, then the parent folder's for anything still missing.

# Default: the AI Foundations course key, used only with gpt-6-luna through Portkey.
PORTKEY_API_KEY=

# Optional alternative: your own OpenAI account, paid by you. To use it, set
# SKILLSIM_PROVIDER=openai and OPENAI_MODEL=<model> (settings, not keys) and fill in:
OPENAI_API_KEY=
